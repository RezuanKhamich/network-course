# Продакшен-настройки API. provision.sh копирует этот файл в /etc/devcourses/api.env (права 640, root:devcourses)
# и подставляет домен. SMTP_URL нужно заполнить вручную — без него сервер не запустится.
NODE_ENV=production

# Unix-сокет и peer-аутентификация: база пускает только системного пользователя devcourses, пароль не нужен
DATABASE_URL=postgresql://devcourses@/devcourses?host=/var/run/postgresql

APP_ORIGIN=https://__DOMAIN__
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=127.0.0.1

# SMTP почтового сервиса домена. Символ @ в логине кодируется как %40. Примеры серверов:
#   Яндекс 360 — smtp.yandex.ru:465, Mail.ru для бизнеса — smtp.mail.ru:465; для них нужен пароль приложения.
SMTP_URL=smtps://no-reply%40__DOMAIN__:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
MAIL_FROM=Курсы для разработчиков <no-reply@__DOMAIN__>

PWNED_CHECK=on
