# Скопируйте в .env. Значения ниже — для локальной разработки с docker compose.
DATABASE_URL=postgres://devcourses:devcourses@127.0.0.1:5433/devcourses
TEST_DATABASE_URL=postgres://devcourses:devcourses@127.0.0.1:5433/devcourses_test

# Адрес фронтенда: из него строятся ссылки в письмах и с ним сверяется заголовок Origin
APP_ORIGIN=http://localhost:5173

HOST=127.0.0.1
PORT=3000

# Без SMTP_URL письма в режиме разработки печатаются в консоль сервера
# SMTP_URL=smtps://no-reply%40example.ru:app-password@smtp.yandex.ru:465
MAIL_FROM=Курсы для разработчиков <no-reply@example.ru>

# Проверка пароля по базе утечек Have I Been Pwned (k-anonymity: уходят 5 символов SHA-1)
PWNED_CHECK=on

# За nginx — адрес nginx (127.0.0.1): только его запись в X-Forwarded-For считается настоящим IP клиента
TRUST_PROXY=false
